# ========================================================
# KopiCerdas AI (KopDas) - .gitignore
# Aturan: Hanya file build bawaan Flutter dan file lokal mesin
# yang mengganggu kinerja tim yang dikecualikan.
# Database (*.db) dan aset proyek diizinkan di-push.
# ========================================================

# --- 1. File Runtime Lock SQLite (Hanya lock & journal sementara) ---
*.db-journal
*.db-wal
*.db-shm

# --- 2. Environment Rahasia Lokal ---
.env
.env.local
.env.*.local

# --- 3. Python Virtual Environment & Cache Mesin ---
.venv/
env/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- 4. File Build & Ephemeral Bawaan Flutter ---
kopdas_app/.dart_tool/
kopdas_app/build/
kopdas_app/.flutter-plugins
kopdas_app/.flutter-plugins-dependencies
kopdas_app/.pub-cache/
kopdas_app/android/local.properties
kopdas_app/windows/flutter/ephemeral/
kopdas_app/linux/flutter/ephemeral/
kopdas_app/macos/Flutter/ephemeral/
kopdas_app/ios/Flutter/ephemeral/

# --- 5. Sampah OS & Konfigurasi Editor Personal ---
.DS_Store
Thumbs.db
.idea/
.vscode/
