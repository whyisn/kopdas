# ========================================================
# KopiCerdas AI Backend Configuration Template
# Salin file ini menjadi .env (Dilarang commit .env ke git)
# ========================================================

# App Setting
PROJECT_NAME="KopiCerdas AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (Flutter Web & Mobile)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:5000"]

# Database Setting (SQLite default for 24h Hackathon stability)
DATABASE_URL="sqlite:///./kopicerdas.db"

# Security (JWT)
SECRET_KEY="kopicerdas-hackathon-24h-insecure-dev-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# QRIS Configuration (Static MPM)
QRIS_MERCHANT_NAME="KopiCerdas Keliling"
QRIS_NMID="ID1020000000001"
QRIS_IMAGE_URL="/assets/qris/merchant_static.png"
QRIS_SIMULATOR_SECRET="qris-dev-sim-secret-key"

# External Integrations (Optional / Fallback to SIMULASI if empty)
GOOGLE_MAPS_API_KEY=""
WEATHER_API_KEY=""
DATA_DEFAULT_LABEL="SIMULASI"
