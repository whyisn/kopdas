# ========================================================
# Kopi Cerdas Backend Configuration Template
# Salin file ini menjadi .env (Dilarang commit .env ke git)
# ========================================================

# App Setting
PROJECT_NAME="Kopi Cerdas API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# --- Database Configuration ---
# Secara default menggunakan SQLite Single Source of Truth
DATABASE_URL="sqlite:///./kopicerdas.db"

# --- Security & JWT Authentication ---
# Ganti dengan string acak aman untuk environment produksi
SECRET_KEY="kopicerdas-hackathon-24h-insecure-dev-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# QRIS Configuration (Static MPM)
QRIS_MERCHANT_NAME="Kopi Cerdas Keliling"
QRIS_NMID="ID1020000000001"
QRIS_IMAGE_URL="/assets/qris/merchant_static.png"
QRIS_SIMULATOR_SECRET="qris-dev-sim-secret-key"

# --- External Service API Keys (Opsional / Integrasi Nyata) ---
# Jika dikosongkan, sistem secara elegan menggunakan model AI offline,
# dataset Padang 84 hari, dan observasi telemetri berlabel SIMULASI.

# 1. Google Maps Platform API Key (Peta Satelit, Places, Geocoding, & Routes)
# Daftar & dapatkan di: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=""

# 2. Weather Provider API Key (Prakiraan Cuaca Real-time)
# Contoh provider: OpenWeatherMap (https://openweathermap.org/api)
WEATHER_API_KEY=""

# --- Provenance & Data Labeling ---
DATA_DEFAULT_LABEL="SIMULASI"
